# --- Vercel project env vars ---
# Gateway password (long + random). Generate: openssl rand -base64 24
APP_PASSWORD=
# Cookie signing key. Generate: openssl rand -hex 32
SESSION_SECRET=
# Public HTTPS URL of your Kali host (from kali/ setup)
KALI_URL=https://kali.example.com

# --- kali/.env (on the Kali host) ---
DOMAIN=kali.example.com
TTYD_USER=kali
TTYD_PASSWORD=
